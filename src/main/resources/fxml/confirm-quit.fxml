<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<AnchorPane fx:id="root" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.memory.controller.ConfirmQuitController"
            stylesheets="@../css/ConfirmQuit.css"
            prefWidth="500.0"
            prefHeight="300.0">

    <children>

          <VBox spacing="20"
                alignment="CENTER"
                AnchorPane.topAnchor="0"
                AnchorPane.bottomAnchor="0"
                AnchorPane.leftAnchor="0"
                AnchorPane.rightAnchor="0">

                <!-- Titre -->
                <Label text="Quitter la partie"
                        styleClass="title"/>

                <!-- Message -->
                <Label text="Voulez-vous vraiment quitter ?"
                        styleClass="text"/>

                <!-- Boutons -->
                <HBox spacing="20" alignment="CENTER">

                        <Button text="Oui"
                                styleClass="btn-danger"
                                onAction="#handleConfirm"/>

                        <Button text="Non"
                                styleClass="btn"
                                onAction="#handleCancel"/>
                </HBox>
        </VBox>

    </children>

</AnchorPane>
